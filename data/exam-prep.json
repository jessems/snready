          "name": "Incident Management",
          "percentage": 12,
          "objectives": [
            "Create and manage incidents",
            "Configure incident states and workflows",
            "Understand priority calculation",
            "Implement escalation rules",
            "Link incidents to other ITSM processes"
          ]
        },
        {
          "name": "Problem Management",
          "percentage": 8,
          "objectives": [
            "Differentiate between incidents and problems",
